# Keep credentials, local state and build noise out of the image context.
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
logs/
.git/
.gitignore

# Never let a key file reach the build context, even by accident.
*.json.key
*-key.json
service-account*.json
application_default_credentials.json

# Local secrets, never in a build context.
.env

# Not needed at runtime.
#
# webchat/ is deliberately NOT listed: this file is per-context, not per
# Dockerfile, and webchat/Dockerfile builds from this same root. Excluding it
# would break the chat image. It stays out of the MCP server's image because
# that Dockerfile copies only pyproject.toml, README.md and goodreads_mcp/ --
# the private service carries none of the public one's code or dependencies.
tests/
deploy-chat.sh
clean_goodreads.py
deploy.sh
Dockerfile
.dockerignore
DATA_NOTES.md
RULES.md
CLAUDE.md
